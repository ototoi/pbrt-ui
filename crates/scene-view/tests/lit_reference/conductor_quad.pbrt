Film "rgb" "integer xresolution" 128 "integer yresolution" 128
LookAt 0 0 5 0 0 0 0 1 0
Camera "perspective" "float fov" 40
WorldBegin
AttributeBegin
AreaLightSource "diffuse" "rgb L" [3 3 3]
Shape "trianglemesh" "point3 P" [-1 3 -1 1 3 -1 1 3 1 -1 3 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
Material "conductor" "spectrum eta" "metal-Au-eta" "spectrum k" "metal-Au-k" "float roughness" 0.04
Shape "sphere"
