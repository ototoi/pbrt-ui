Film "rgb" "integer xresolution" 128 "integer yresolution" 128
LookAt 0 0 3.5 0 0 0 0 1 0
Camera "perspective" "float fov" 45
WorldBegin
AttributeBegin
Rotate 70 1 1 0
LightSource "infinite" "string filename" "env.exr"
AttributeEnd
Material "diffuse" "rgb reflectance" [0.8 0.8 0.8]
Shape "sphere" "float radius" 0.9
