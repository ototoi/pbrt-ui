Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "trianglemesh" "point3 P" [-3 -3 0 3 -3 0 3 3 0 -3 3 0] "integer indices" [0 1 2 0 2 3]
Shape "trianglemesh" "point3 P" [-2 -2 1 2 -2 1 2 2 1 -2 2 1] "texcoord2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3] "texture alpha" "a"
