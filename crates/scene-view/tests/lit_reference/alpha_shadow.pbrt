Film "rgb" "integer xresolution" 128 "integer yresolution" 128
LookAt 0 -5 3 0 0 0.3 0 0 1
Camera "perspective" "float fov" 45
WorldBegin
Texture "a" "float" "checkerboard" "float uscale" [2] "float vscale" [2] "float tex1" [1] "float tex2" [0] "string aamode" "none"
