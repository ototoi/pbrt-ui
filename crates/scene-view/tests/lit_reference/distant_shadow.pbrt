Film "rgb" "integer xresolution" 128 "integer yresolution" 128
LookAt 0 -5 3 0 0 0.3 0 0 1
Camera "perspective" "float fov" 45
WorldBegin
LightSource "distant" "point3 from" [1 -0.5 1.5] "point3 to" [0 0 0] "rgb L" [3 3 3]
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "trianglemesh" "point3 P" [-3 -3 0 3 -3 0 3 3 0 -3 3 0] "integer indices" [0 1 2 0 2 3]
AttributeBegin
Translate 0 0 0.5
Shape "sphere" "float radius" 0.5
AttributeEnd
