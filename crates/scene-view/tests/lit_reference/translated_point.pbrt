Film "rgb" "integer xresolution" 128 "integer yresolution" 128
LookAt 0 0 5 0 0 0 0 1 0
Camera "perspective" "float fov" 40
WorldBegin
AttributeBegin
Translate 2 1 0
LightSource "point" "point from" [0 0 2] "rgb I" [40 35 30]
AttributeEnd
Material "diffuse" "rgb reflectance" [0.55 0.45 0.35]
Shape "sphere" "float radius" 1
