Film "rgb" "integer xresolution" 128 "integer yresolution" 128
LookAt 0 0 8 0 0 0 0 1 0
Camera "perspective" "float fov" 40
WorldBegin
Material "diffuse" "rgb reflectance" [0.7 0.6 0.5]
Shape "sphere" "float radius" 1
AttributeBegin
Translate 0 0 4
AreaLightSource "diffuse" "rgb L" [10 10 10] "bool twosided" true
Shape "trianglemesh" "point3 P" [-0.2 -0.2 0 0.2 -0.2 0 0.2 0.2 0 -0.2 0.2 0] "integer indices" [0 2 1 0 3 2]
AttributeEnd
