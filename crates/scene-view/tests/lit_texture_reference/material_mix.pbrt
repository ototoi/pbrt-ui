Film "rgb" "integer xresolution" [128] "integer yresolution" [128]
LookAt 0 0 5  0 0 0  0 1 0
Camera "perspective" "float fov" [45]
Sampler "halton" "integer pixelsamples" [4096]
Integrator "path" "integer maxdepth" [1]
WorldBegin
Texture "amount" "float" "checkerboard" "float uscale" [3] "float vscale" [3] "float tex1" [0.2] "float tex2" [0.9]
Texture "nested" "float" "bilerp" "float v00" [0] "float v01" [0] "float v10" [1] "float v11" [1]
MakeNamedMaterial "red" "string type" "diffuse" "rgb reflectance" [0.9 0.1 0.1]
MakeNamedMaterial "green" "string type" "diffuse" "rgb reflectance" [0.1 0.9 0.1]
MakeNamedMaterial "blue" "string type" "diffuse" "rgb reflectance" [0.1 0.1 0.9]
MakeNamedMaterial "inner" "string type" "mix" "string materials" ["green" "blue"] "texture amount" "nested"
MakeNamedMaterial "outer" "string type" "mix" "string materials" ["red" "inner"] "texture amount" "amount"
NamedMaterial "outer"
LightSource "infinite" "rgb L" [1 1 1]
Shape "trianglemesh" "point3 P" [-1 -1 0 1 -1 0 1 1 0 -1 1 0] "texcoord2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
