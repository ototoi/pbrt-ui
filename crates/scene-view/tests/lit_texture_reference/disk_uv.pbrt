Film "rgb" "integer xresolution" [128] "integer yresolution" [128]
LookAt 0 0 5  0 0 0  0 1 0
Camera "perspective" "float fov" [45]
Sampler "halton" "integer pixelsamples" [4096]
Integrator "path" "integer maxdepth" [1]
WorldBegin
Texture "result" "spectrum" "bilerp" "rgb v00" [0.9 0.1 0.1] "rgb v10" [0.1 0.9 0.1] "rgb v01" [0.1 0.1 0.9] "rgb v11" [0.9 0.9 0.1]
LightSource "infinite" "rgb L" [1 1 1]
AttributeBegin
Material "diffuse" "rgb reflectance" [0.02 0.02 0.02]
Shape "trianglemesh" "point3 P" [-30 -30 -50 30 -30 -50 30 30 -50 -30 30 -50] "integer indices" [0 1 2 0 2 3]
AttributeEnd
Material "diffuse" "texture reflectance" "result"
Rotate 25 0 1 0
Shape "disk" "float radius" [1.5] "float phimax" [300]
